# Rootwear — environment. Copy to .env and fill in. .env is gitignored.
#
# NEVER commit real values. NEVER expose a secret to the client: only
# PUBLIC_-prefixed variables reach the browser in SvelteKit.

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe in the browser. RLS is what protects the data.
PUBLIC_SUPABASE_ANON_KEY=

# Secret (service-role) key. BYPASSES RLS — server only, never in a client
# bundle, never in a PUBLIC_ variable. Rotate immediately if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, migrations only (not used by the app at runtime).
# Use the pooler on :6543 for serverless; :5432 is unpooled and IPv6-only.
DATABASE_URL=

# Optional override. Leave blank to use Supabase automatically when all three
# keys above are present, falling back to fixtures when they are not. Set to
# "mock" only when you deliberately want fixture data with a configured DB.
CATALOGUE_SOURCE=

# --- Razorpay -------------------------------------------------------------
# BLOCKED on RW-005: no checkout code runs until the account is confirmed in
# writing with KYC cleared. Test-mode keys are fine to develop against.
# Set to "razorpay" (with all three values below) to use the real gateway;
# anything else uses the mock. Keys from Dashboard -> Account & Settings ->
# API Keys; webhook secret is the one you type when creating the webhook.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Distinct from KEY_SECRET. Used to verify webhook signatures (RW-098).
RAZORPAY_WEBHOOK_SECRET=

# --- Scheduled jobs -------------------------------------------------------
# Shared secret for the protected cron endpoints (RW-021).
CRON_SECRET=
# Minutes an order may sit unpaid before it is cancelled and its stock is put
# back on sale (POST /api/cron/expire-orders, and opportunistically at
# checkout). Default 10. Razorpay's checkout window closes at the same time.
ORDER_PAYMENT_WINDOW_MINUTES=

# --- Admin bootstrap ------------------------------------------------------
# Used ONLY by `node scripts/create-admin.mjs` to create a staff login.
# Never committed with a real value; never reused anywhere else.
# role: "owner" = full access, "layout" = pages/banners/copy only (§12).
ADMIN_LOGIN_ID=admin@rootwear
ADMIN_EMAIL=admin@rootwear.in
ADMIN_PASSWORD=
# Required when local credentials are used without Supabase. Generate a long,
# random value; it signs the HttpOnly admin session cookie.
ADMIN_SESSION_SECRET=
ADMIN_ROLE=owner

# --- Site -----------------------------------------------------------------
# Public origin used in links inside emails and WhatsApp messages.
PUBLIC_SITE_URL=https://rootwear.in

# --- Email ----------------------------------------------------------------
# ZeptoMail is used when its token is set; otherwise SMTP (your existing
# mailbox); otherwise messages are logged in admin but not sent.
# Token: ZeptoMail -> Mail Agents -> SMTP/API -> Send Mail token.
ZEPTOMAIL_TOKEN=
# India-region accounts use api.zeptomail.in; others api.zeptomail.com.
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# The sender. Must be verified in ZeptoMail (or be the SMTP mailbox).
EMAIL_FROM=hi@rootwear.in
EMAIL_FROM_NAME=Rootwear
# SMTP fallback. Needs a Node runtime (not an edge function).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- WhatsApp & Meta ------------------------------------------------------
# WhatsApp Cloud API: Meta app -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent System User token with whatsapp_business_messaging (and
# leads_retrieval + pages_manage_metadata for lead ads).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Webhook (/api/webhooks/meta): app secret verifies signatures; the verify
# token is any long random string you also paste into Meta's webhook form.
META_APP_SECRET=
META_VERIFY_TOKEN=
