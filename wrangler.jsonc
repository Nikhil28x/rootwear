// The website. Deploy with `npm run deploy`; secrets with `npx wrangler secret put NAME`.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rootwear",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// Run next to Supabase (Singapore), not next to the visitor: a page makes
	// several database round trips and each one would otherwise cross the
	// India–Singapore link. Static assets are still served from the edge.
	"placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
	"routes": [
		{ "pattern": "rootwearclothing.com", "custom_domain": true },
		{ "pattern": "www.rootwearclothing.com", "custom_domain": true }
	],
	// Per-visitor limits on form posts (src/lib/server/ratelimit.ts). The
	// namespace ids only need to be unique within the Cloudflare account.
	"ratelimits": [
		{ "name": "LIMIT_STRICT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LIMIT_FORMS", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
	],
	// Non-secret settings. Keys and tokens go in as secrets, never here.
	"vars": {
		"PUBLIC_SITE_URL": "https://rootwearclothing.com"
	}
}
