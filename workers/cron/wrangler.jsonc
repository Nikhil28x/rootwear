// Calls the website's scheduled jobs. Deploy with `npm run deploy:cron`.
// Needs the same CRON_SECRET as the website: `npx wrangler secret put CRON_SECRET -c workers/cron/wrangler.jsonc`.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "rootwear-cron",
	"main": "index.js",
	"compatibility_date": "2026-09-01",
	"vars": {
		"SITE_URL": "https://rootwearclothing.com"
	},
	"triggers": {
		// One tick; index.js decides what runs on it. Times are UTC.
		"crons": ["*/15 * * * *"]
	},
	"observability": { "enabled": true }
}
